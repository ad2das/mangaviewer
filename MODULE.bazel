module(name = "mangaviewer_ui", version = "0.1.0")

bazel_dep(name = "rules_android", version = "0.6.6")
bazel_dep(name = "rules_jvm_external", version = "7.0.0")
bazel_dep(name = "rules_kotlin", version = "2.1.3")

remote_android_extensions = use_extension(
    "@rules_android//bzlmod_extensions:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_tools")

android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
use_repo(android_sdk_repository_extension, "androidsdk")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "androidx.appcompat:appcompat:1.5.1",
        "androidx.cardview:cardview:1.0.0",
        "androidx.constraintlayout:constraintlayout:2.1.4",
        "androidx.core:core:1.9.0",
        "androidx.documentfile:documentfile:1.0.1",
        "androidx.drawerlayout:drawerlayout:1.1.1",
        "androidx.fragment:fragment:1.5.5",
        "androidx.legacy:legacy-support-v4:1.0.0",
        "androidx.lifecycle:lifecycle-livedata-ktx:2.8.7",
        "androidx.lifecycle:lifecycle-viewmodel-ktx:2.8.7",
        "androidx.multidex:multidex:2.0.1",
        "androidx.recyclerview:recyclerview:1.3.2",
        "androidx.room:room-compiler:2.6.1",
        "androidx.room:room-runtime:2.6.1",
        "androidx.swiperefreshlayout:swiperefreshlayout:1.1.0",
        "androidx.vectordrawable:vectordrawable:1.1.0",
        "androidx.viewpager:viewpager:1.0.0",
        "androidx.work:work-runtime:2.9.1",
        "com.github.bumptech.glide:annotations:4.14.0",
        "com.github.bumptech.glide:compiler:4.14.0",
        "com.github.bumptech.glide:glide:4.14.0",
        "com.github.bumptech.glide:okhttp3-integration:4.14.0",
        "com.github.bumptech.glide:recyclerview-integration:4.14.0",
        "com.github.omadahealth:swipy:1.2.3",
        "com.google.android.flexbox:flexbox:3.0.0",
        "com.google.android.gms:play-services-auth:20.7.0",
        "com.google.android.material:material:1.7.0",
        "com.google.code.gson:gson:2.10",
        "com.google.firebase:firebase-auth",
        "com.google.firebase:firebase-firestore",
        "com.google.guava:guava:33.3.1-android",
        "com.squareup.okhttp3:okhttp:4.12.0",
        "org.apache.commons:commons-text:1.7",
        "org.jetbrains.kotlinx:kotlinx-coroutines-android:1.9.0",
        "org.jsoup:jsoup:1.15.3",
    ],
    boms = [
        "com.google.firebase:firebase-bom:34.12.0",
    ],
    fail_on_missing_checksum = False,
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
        "https://jitpack.io",
    ],
)
use_repo(maven, "maven")
