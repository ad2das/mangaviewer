+                        + ",fromCache=" + (chunk != null && chunk.fromCache)
+                        + ",bodyLen=" + chunkBody.length()
+                        + ",ms=" + (System.currentTimeMillis() - startedAt));
+                if(chunk != null && chunk.code >= 200 && chunk.code < 400
+                        && chunkBody.length() > 0) {
