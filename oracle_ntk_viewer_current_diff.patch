+    private fun completeInitialContinuousGeneratedPrefix(
+        context: Context,
+        manga: Manga,
+        image: String,
+        page: Int,
+        reason: String
+    ) {
+        if (cachedFile(context, manga, image) != null) return
+        val target = ntkGeneratedTarget(image) ?: return
