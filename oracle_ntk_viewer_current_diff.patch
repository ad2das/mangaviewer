+    fun runWhenNtkInitialGeneratedAssetReady(
+        context: Context,
+        manga: Manga,
+        image: String,
+        callback: Runnable
+    ): Boolean {
+        val assetKey = ntkInitialGeneratedAssetKey(manga, image) ?: return false
+        fun readyFile(): File? {
+            val known = ntkInitialGeneratedAssetFiles[assetKey]
+            if (known != null) {
