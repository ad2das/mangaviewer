+        StringBuilder merged = new StringBuilder(body.length() + 32768 + aliasPayload.length());
+        merged.append(body);
+        if(aliasPayload.length() > 0)
+            merged.append('\n').append(aliasPayload);
+        int fetched = 0;
+        int attempted = 0;
+        for(String chunkPath : chunks) {
+            if(chunkPath == null || chunkPath.length() == 0)
+                continue;
+            if(attempted >= 4)
+                break;
