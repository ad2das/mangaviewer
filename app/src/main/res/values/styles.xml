<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme.Launcher">
        <item name="android:windowBackground">@drawable/launch_screen</item>
    </style>

    <!-- Base application theme - Modern Light -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorPrimaryContainer">@color/appAccentLight</item>
        <item name="colorOnPrimary">@color/colorTextOnPrimary</item>
        <item name="colorSecondaryContainer">@color/colorAccentLight</item>
        <item name="colorOnSecondaryContainer">@color/colorAccent</item>

        <!-- Surface Colors -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOutline">@color/colorOutline</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="android:textColorHint">@color/colorTextMuted</item>

        <!-- Window / System -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Component Styles -->
        <item name="materialCardViewStyle">@style/AppCard</item>
        <item name="materialButtonStyle">@style/AppButton</item>
        <item name="textInputStyle">@style/AppTextInput</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.Episode" parent="AppTheme.NoActionBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@style/AppTheme.ReaderV2.NoAnimation</item>
    </style>

    <style name="AppTheme.Viewer" parent="AppTheme.NoActionBar">
        <item name="android:windowActionBarOverlay">true</item>
        <item name="windowActionBarOverlay">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="AppTheme.ReaderV2" parent="AppTheme.Viewer">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/AppTheme.ReaderV2.NoAnimation</item>
    </style>

    <style name="AppTheme.ReaderV2.NoAnimation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
        <item name="android:taskToFrontEnterAnimation">@null</item>
        <item name="android:taskToFrontExitAnimation">@null</item>
        <item name="android:taskToBackEnterAnimation">@null</item>
        <item name="android:taskToBackExitAnimation">@null</item>
    </style>

    <!-- Dark Theme -->
    <style name="AppThemeDark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorPrimaryContainer">@color/colorDarkSurfaceElevated</item>
        <item name="colorOnPrimary">@color/colorTextOnPrimary</item>

        <item name="android:colorBackground">@color/colorDarkBackground</item>
        <item name="colorSurface">@color/colorDarkSurface</item>
        <item name="colorSurfaceVariant">@color/colorDarkSurfaceElevated</item>
        <item name="colorOutline">@color/colorDarkDivider</item>

        <item name="android:textColorPrimary">@color/colorDarkText</item>
        <item name="android:textColorSecondary">@color/colorDarkTextSecondary</item>
        <item name="android:textColorHint">@color/colorDarkTextSecondary</item>
        <item name="android:editTextColor">@color/colorDarkText</item>
        <item name="android:itemBackground">@color/colorDarkWindowBackground</item>
        <item name="android:windowBackground">@color/colorDarkWindowBackground</item>
        <item name="android:textColor">@color/colorDarkText</item>

        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:navigationBarColor">@color/colorDarkBackground</item>
        <item name="android:statusBarColor">@color/colorDarkBackground</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="materialCardViewStyle">@style/AppCard.Dark</item>
    </style>

    <style name="AppThemeDarkNoTitle" parent="AppThemeDark">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppThemeBlackNoTitle" parent="AppThemeDark">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:itemBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Dialog -->
    <style name="darkDialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="android:background">@color/colorDarkSurface</item>
        <item name="android:textColor">@color/colorDarkText</item>
    </style>

    <!-- Card Style -->
    <style name="AppCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="AppCard.Dark" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/colorDarkSurface</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Button Style -->
    <style name="AppButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Text Input Style -->
    <style name="AppTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- AppBar -->
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.Dark" />
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <!-- Tab Text -->
    <style name="AppTabText" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ShapeableImageView -->
    <style name="RoundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Toolbar Title -->
    <style name="AppToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/appText</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Bottom Nav Text -->
    <style name="AppBottomNavText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="AppBottomNavText.Active" parent="AppBottomNavText">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Base App Text -->
    <style name="AppText" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/appText</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="AppText.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/appText</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="AppText.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="AppText.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/appTextSecondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="AppText.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/appTextSecondary</item>
    </style>

    <style name="AppText.Header" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/appText</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="AppText.Action" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/colorAccent</item>
    </style>

    <style name="AppText.CardTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/appText</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="AppText.CardMeta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/appTextSecondary</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

</resources>
