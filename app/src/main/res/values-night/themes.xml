        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#7C5CFF</item>
        <item name="android:windowBackground">#090A10</item>
        <item name="android:navigationBarColor">#090A10</item>
        <item name="android:statusBarColor">#090A10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
