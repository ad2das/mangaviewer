<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#FEE4E2" />
            <stroke android:width="1dp" android:color="#D92D20" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/appCard" />
            <stroke android:width="1dp" android:color="#FDA29B" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
