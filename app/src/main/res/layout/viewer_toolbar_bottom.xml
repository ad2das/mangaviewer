<?xml version="1.0" encoding="utf-8" standalone="no"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="@color/appCard"
    android:visibility="visible">

    <ImageButton
        android:id="@+id/toolbar_next"
        android:layout_width="50dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/viewer_nav_button_bg"
        android:contentDescription="다음 회차"
        android:elevation="3dp"
        android:padding="10dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_right"
        app:tint="@color/appCard" />

    <ImageButton
        android:id="@+id/toolbar_spinner"
        android:layout_width="50dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/viewer_episode_button_bg"
        android:contentDescription="회차 선택"
        android:elevation="3dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:scaleType="centerInside"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/toolbar_next"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_list"
        app:tint="@color/appCard" />

    <ImageButton
        android:id="@+id/toolbar_previous"
        android:layout_width="50dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/viewer_nav_button_bg"
        android:contentDescription="이전 회차"
        android:elevation="3dp"
        android:padding="10dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/toolbar_spinner"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_left"
        app:tint="@color/appCard" />

    <Button
        android:background="@drawable/app_outline_button_bg"
        android:foreground="?android:attr/selectableItemBackground"
        android:id="@+id/viewerBtn1"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_width="0dp"
        android:maxLines="1"
        android:minWidth="72dp"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:ellipsize="end"
        android:text="기능1"
        android:textColor="@color/appText"
        android:textSize="13sp"
        app:autoSizeMaxTextSize="13sp"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toStartOf="@id/viewerBtn2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:background="@drawable/app_outline_button_bg"
        android:foreground="?android:attr/selectableItemBackground"
        android:id="@+id/viewerBtn2"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="8dp"
        android:layout_width="0dp"
        android:maxLines="1"
        android:minWidth="72dp"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:ellipsize="end"
        android:text="기능2"
        android:textColor="@color/appText"
        android:textSize="13sp"
        app:autoSizeMaxTextSize="13sp"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/toolbar_previous"
        app:layout_constraintStart_toEndOf="@id/viewerBtn1"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
