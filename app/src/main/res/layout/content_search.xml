<?xml version="1.0" encoding="utf-8" standalone="no"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appSurface"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".activity.MainActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/appCard"
        app:layout_constraintEnd_toStartOf="@+id/searchSubmitButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/searchBox"
            style="@style/AppText.Body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:contentDescription="검색어"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:hint="@string/search_hint"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/appText"
            android:textColorHint="@color/appTextSecondary"
            android:visibility="visible" />

    </androidx.cardview.widget.CardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/searchSubmitButton"
        android:layout_width="80dp"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="@string/search_action"
        android:textColor="@color/colorTextOnPrimary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/appAccent"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/searchCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/searchCard" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/searchOptionPanel"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/searchCard">

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/searchBaseMode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/app_space_sm"
            android:background="@drawable/app_search_filter_bg"
            android:layout_weight="1"
            android:entries="@array/baseOption" />

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/searchMode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/app_search_filter_bg"
            android:layout_weight="1"
            android:entries="@array/searchModes" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/libraryTab"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/appSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/appAccent"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/appAccent"
        app:tabTextAppearance="@style/AppTabText"
        app:tabTextColor="@color/appTextSecondary"
        app:layout_constraintTop_toBottomOf="@+id/searchOptionPanel" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/libraryMeta"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/libraryTab">

        <TextView
            android:id="@+id/libraryCount"
            style="@style/AppText.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="42개 작품" />

        <TextView
            android:id="@+id/librarySort"
            style="@style/AppText.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_recent_update"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.omadahealth.github.swipyrefreshlayout.library.SwipyRefreshLayout
        android:id="@+id/searchSwipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/libraryMeta"
        app:srl_direction="bottom">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/app_space_sm"
            android:paddingBottom="24dp"
            android:scrollbars="vertical"
            android:layoutAnimation="@anim/layout_animation_slide_up" />

    </com.omadahealth.github.swipyrefreshlayout.library.SwipyRefreshLayout>

    <LinearLayout
        android:id="@+id/noResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/app_info_panel_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/app_space_lg"
        android:paddingTop="@dimen/app_space_lg"
        android:paddingEnd="@dimen/app_space_lg"
        android:paddingBottom="@dimen/app_space_lg"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/searchSwipe"
        app:layout_constraintEnd_toEndOf="@+id/searchSwipe"
        app:layout_constraintStart_toStartOf="@+id/searchSwipe"
        app:layout_constraintTop_toTopOf="@+id/searchSwipe">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_search"
            app:tint="@color/appTextMuted" />

        <TextView
            android:id="@+id/noResultText"
            style="@style/AppText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_space_md"
            android:gravity="center"
            android:text="@string/no_items_message"
            android:textColor="@color/appTextSecondary" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/advSearchBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/app_space_lg"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/searchSwipe"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_adv_search" />

</androidx.constraintlayout.widget.ConstraintLayout>
