<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/appSurface"
    android:orientation="vertical"
    android:paddingStart="@dimen/app_space_lg"
    android:paddingTop="@dimen/app_space_lg"
    android:paddingEnd="@dimen/app_space_lg"
    android:paddingBottom="@dimen/app_space_lg">

    <TextView
        style="@style/AppText.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="장르 둘러보기"
        android:textColor="@color/appText" />

    <TextView
        style="@style/AppText.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/app_space_xs"
        android:text="원하는 조건을 골라 바로 이동"
        android:textColor="@color/appTextSecondary" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/webtoon_filter_sections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/app_space_md" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/webtoon_status_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/webtoon_genre_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

</androidx.appcompat.widget.LinearLayoutCompat>
