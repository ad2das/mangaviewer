<?xml version="1.0" encoding="utf-8" standalone="no"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/appSurface"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    tools:context=".activity.EpisodeActivity">

    <com.google.android.material.appbar.AppBarLayout
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/episode_toolbar"
        android:background="@color/appSurface"
        android:elevation="0dp"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        app:elevation="0dp">

        <ml.melun.mangaview.ui.MarqueeToolbar
            android:background="@color/appSurface"
            android:id="@+id/toolbar"
            android:layout_height="?attr/actionBarSize"
            android:layout_width="match_parent"
            app:titleTextColor="@color/appText"
            app:popupTheme="@style/AppTheme.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>

    <ml.melun.mangaview.ui.DragHandleRecyclerView
        android:id="@+id/EpisodeList"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingEnd="42dp"
        android:paddingBottom="14dp"
        android:layout_height="0dp"
        android:layout_width="match_parent"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/episode_toolbar">

    </ml.melun.mangaview.ui.DragHandleRecyclerView>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/episode_empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/app_info_panel_bg"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/episode_toolbar">

        <TextView
            android:id="@+id/episode_empty_title"
            style="@style/AppText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/appText"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/episode_empty_message"
            style="@style/AppText.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/appTextSecondary" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <ViewStub
        android:id="@+id/episode_fab_stub"
        android:inflatedId="@+id/fab_container"
        android:layout="@layout/episode_fab_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
