<?xml version="1.0" encoding="utf-8" standalone="no"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/titleCard"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="@dimen/app_space_xs"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="@dimen/app_space_xs"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="@color/appCard"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titleContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingEnd="8dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/thumbCard"
                android:layout_width="92dp"
                android:layout_height="124dp"
                android:layout_marginStart="14dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/Thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/app_cover_placeholder"
                    android:scaleType="centerCrop" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/Title"
                style="@style/AppText.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="@dimen/app_space_sm"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="3"
                android:singleLine="false"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="11sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toStartOf="@+id/epsButton"
                app:layout_constraintStart_toEndOf="@+id/thumbCard"
                app:layout_constraintTop_toTopOf="@+id/thumbCard"
                tools:text="Solo Leveling" />

            <TextView
                android:id="@+id/TitleAuthor"
                style="@style/AppText.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="@dimen/app_space_sm"
                android:ellipsize="end"
                android:maxLines="1"
                app:layout_constraintEnd_toStartOf="@+id/epsButton"
                app:layout_constraintStart_toEndOf="@+id/thumbCard"
                app:layout_constraintTop_toBottomOf="@+id/Title"
                tools:text="Episode 179" />

            <ProgressBar
                android:id="@+id/TitleProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:max="100"
                android:progressDrawable="@drawable/app_progress_bar"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/TitleProgressText"
                app:layout_constraintEnd_toStartOf="@+id/TitleProgressText"
                app:layout_constraintStart_toEndOf="@+id/thumbCard"
                app:layout_constraintTop_toTopOf="@+id/TitleProgressText" />

            <TextView
                android:id="@+id/TitleProgressText"
                style="@style/AppText.Caption"
                android:layout_width="52dp"
                android:layout_height="22dp"
                android:gravity="end"
                android:includeFontPadding="false"
                android:textColor="@color/appTextSecondary"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/thumbCard"
                app:layout_constraintEnd_toStartOf="@+id/epsButton"
                app:layout_constraintTop_toBottomOf="@+id/TitleTagContainer"
                app:layout_constraintVertical_bias="1"
                tools:text="" />

            <ImageButton
                android:id="@+id/epsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/app_accent_button_bg"
                android:contentDescription="이어보기"
                android:foreground="?android:attr/selectableItemBackground"
                android:padding="9dp"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/play" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/TitleCounterContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/TitleRecommend_c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/TitleBattery_c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/TitleBookmark_c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/TitleTagContainer"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/app_space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toStartOf="@+id/epsButton"
                app:layout_constraintStart_toEndOf="@+id/thumbCard"
                app:layout_constraintTop_toBottomOf="@+id/TitleAuthor"
                app:layout_constraintBottom_toTopOf="@+id/TitleProgress"
                app:layout_constraintVertical_bias="0">

                <TextView
                    android:id="@+id/TitleBaseMode"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/app_soft_chip_bg"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="38dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/appAccent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="웹툰" />

                <TextView
                    android:id="@+id/TitleTag"
                    style="@style/AppText.Caption"
                    android:layout_width="0dp"
                    android:layout_height="22dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    tools:text="액션 판타지 드라마" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.appcompat.widget.LinearLayoutCompat>
