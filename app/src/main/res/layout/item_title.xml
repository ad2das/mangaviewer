<?xml version="1.0" encoding="utf-8" standalone="no"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/titleCard"
        android:layout_width="match_parent"
        android:layout_height="172dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/appCard"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:rippleColor="@color/appAccentLight"
        app:strokeColor="@color/appDivider"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titleContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingEnd="10dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/Thumb"
                android:layout_width="96dp"
                android:layout_height="132dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/app_cover_placeholder"
                android:contentDescription="@string/cover_image"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/RoundedImageView" />

            <TextView
                android:id="@+id/ThumbStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/app_thumb_badge_ongoing_bg"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/appCard"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/Thumb"
                app:layout_constraintTop_toTopOf="@id/Thumb"
                tools:text="연재"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/Title"
                style="@style/AppText.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="3"
                android:singleLine="false"
                android:textStyle="bold"
                android:textColor="@color/appText"
                android:textSize="16sp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toStartOf="@+id/epsButton"
                app:layout_constraintStart_toEndOf="@id/Thumb"
                app:layout_constraintTop_toTopOf="@id/Thumb"
                tools:text="Solo Leveling" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/TitleTagContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="20dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toStartOf="@+id/epsButton"
                app:layout_constraintStart_toEndOf="@id/Thumb"
                app:layout_constraintTop_toBottomOf="@+id/Title">

                <TextView
                    android:id="@+id/TitleBaseMode"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/app_soft_chip_bg"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="36dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/appAccent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="웹툰" />

                <TextView
                    android:id="@+id/TitleTag"
                    style="@style/AppText.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:minHeight="20dp"
                    android:textSize="12sp"
                    tools:text="액션 판타지 드라마" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <TextView
                android:id="@+id/TitleAuthor"
                style="@style/AppText.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="13sp"
                android:textColor="@color/appTextSecondary"
                app:layout_constraintEnd_toStartOf="@+id/epsButton"
                app:layout_constraintStart_toEndOf="@id/Thumb"
                app:layout_constraintTop_toBottomOf="@+id/TitleTagContainer"
                tools:text="Episode 179" />

            <ProgressBar
                android:id="@+id/TitleProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="10dp"
                android:max="100"
                android:progressDrawable="@drawable/app_progress_bar"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/TitleProgressText"
                app:layout_constraintEnd_toStartOf="@+id/TitleProgressText"
                app:layout_constraintStart_toEndOf="@id/Thumb"
                app:layout_constraintTop_toTopOf="@+id/TitleProgressText" />

            <TextView
                android:id="@+id/TitleProgressText"
                style="@style/AppText.Caption"
                android:layout_width="52dp"
                android:layout_height="22dp"
                android:gravity="end"
                android:includeFontPadding="false"
                android:textColor="@color/appTextSecondary"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/Thumb"
                app:layout_constraintEnd_toStartOf="@+id/epsButton"
                app:layout_constraintTop_toBottomOf="@+id/TitleAuthor"
                app:layout_constraintVertical_bias="1"
                tools:text="" />

            <ImageButton
                android:id="@+id/epsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/app_accent_button_bg"
                android:contentDescription="@string/resume_reading"
                android:foreground="?android:attr/selectableItemBackground"
                android:padding="10dp"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/play" />

            <ImageView
                android:id="@+id/TitleResumeSiteIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/app_toolbar_icon_bg"
                android:contentDescription="@string/site_icon"
                android:elevation="3dp"
                android:padding="4dp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/epsButton"
                app:layout_constraintEnd_toEndOf="@+id/epsButton"
                app:srcCompat="@drawable/ic_site_wfwf"
                tools:srcCompat="@drawable/ic_site_ntk"
                tools:visibility="visible" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/TitleCounterContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/TitleRecommend_c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/TitleBattery_c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/TitleBookmark_c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
