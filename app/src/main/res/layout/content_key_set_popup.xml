<?xml version="1.0" encoding="utf-8" standalone="no"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="@color/appSurface"
    android:orientation="vertical"
    android:paddingStart="@dimen/app_space_lg"
    android:paddingTop="@dimen/app_space_md"
    android:paddingEnd="@dimen/app_space_lg"
    android:paddingBottom="@dimen/app_space_sm">

    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_prev"
            style="@style/AppText.Action"
            android:layout_height="44dp"
            android:layout_marginEnd="@dimen/app_space_md"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:background="@drawable/app_outline_button_bg"
            android:foreground="?android:attr/selectableItemBackground"
            android:minHeight="0dp"
            android:text="이전 페이지"
            android:textAllCaps="false"
            android:textColor="@color/appText" />

        <TextView
            android:id="@+id/key_prev_text"
            style="@style/AppText.Meta"
            android:layout_gravity="center"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:textAlignment="center"
            android:textColor="@color/appText" />

    </LinearLayout>

    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_next"
            style="@style/AppText.Action"
            android:layout_height="44dp"
            android:layout_marginEnd="@dimen/app_space_md"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:background="@drawable/app_outline_button_bg"
            android:foreground="?android:attr/selectableItemBackground"
            android:minHeight="0dp"
            android:text="다음 페이지"
            android:textAllCaps="false"
            android:textColor="@color/appText" />

        <TextView
            android:id="@+id/key_next_text"
            style="@style/AppText.Meta"
            android:layout_gravity="center"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:textAlignment="center"
            android:textColor="@color/appText" />

    </LinearLayout>

</LinearLayout>
