<?xml version="1.0" encoding="utf-8" standalone="no"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/appSurface"
    android:paddingStart="@dimen/app_space_lg"
    android:paddingTop="14dp"
    android:paddingEnd="@dimen/app_space_lg"
    android:paddingBottom="10dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/headerCoverCard"
        android:layout_width="118dp"
        android:layout_height="160dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/HeaderThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/app_cover_placeholder"
            android:scaleType="centerCrop"
            app:srcCompat="@mipmap/ic_launcher" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/HeaderTitle"
        style="@style/AppText.Header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/app_space_lg"
        android:layout_marginTop="18dp"
        android:ellipsize="end"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/headerCoverCard"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Solo Leveling" />

    <TextView
        android:id="@+id/headerAuthor"
        style="@style/AppText.Meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/app_space_lg"
        android:layout_marginTop="@dimen/app_space_sm"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/headerCoverCard"
        app:layout_constraintTop_toBottomOf="@+id/HeaderTitle"
        tools:text="Dubu(REDICE STUDIO)" />

    <TextView
        android:id="@+id/HeaderRelease"
        style="@style/AppText.Meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/app_space_lg"
        android:layout_marginTop="@dimen/app_space_sm"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/headerCoverCard"
        app:layout_constraintTop_toBottomOf="@+id/headerAuthor"
        tools:text="Chugong" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tagsContainer"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="@dimen/app_space_lg"
        android:layout_marginTop="@dimen/app_space_md"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/headerCoverCard"
        app:layout_constraintTop_toBottomOf="@+id/HeaderRelease" />

    <LinearLayout
        android:id="@+id/HeaderRecommend"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/app_space_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toEndOf="@+id/headerCoverCard"
        app:layout_constraintTop_toBottomOf="@+id/tagsContainer">

        <ImageView
            android:id="@+id/recommendIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:srcCompat="@drawable/ic_thumb" />

        <TextView
            android:id="@+id/recommendText"
            style="@style/AppText.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_space_xs"
            tools:text="4.9" />

    </LinearLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/HeaderBtnContainer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/app_space_xl"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerCoverCard">

        <Button
            android:id="@+id/HeaderFirst"
            style="@style/AppText.Action"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/app_accent_button_bg"
            android:enabled="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="바로 읽기"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/HeaderFavorite"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="@dimen/app_space_md"
            android:background="@drawable/app_outline_button_bg"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center">

            <ImageView
                android:id="@+id/favoriteIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:srcCompat="@drawable/ic_favorite_border" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/HeaderBookmark"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="@dimen/app_space_sm"
            android:background="@drawable/app_outline_button_bg"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center">

            <ImageView
                android:id="@+id/bookmarkIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:srcCompat="@drawable/ic_bookmark_border" />

        </LinearLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/detailTabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/HeaderBtnContainer">

        <TextView
            android:id="@+id/detailIntroTab"
            style="@style/AppText.Meta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="소개"
            android:textColor="@color/appText"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailEpisodeTab"
            style="@style/AppText.Meta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="회차"
            android:textColor="@color/appTextSecondary" />

        <TextView
            android:id="@+id/detailInfoTab"
            style="@style/AppText.Meta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="정보"
            android:textColor="@color/appTextSecondary" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:id="@+id/detailTabIndicator"
        android:layout_width="96dp"
        android:layout_height="2dp"
        android:background="@color/appAccent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/detailTabs" />

    <LinearLayout
        android:id="@+id/detailContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/app_space_lg"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/detailTabIndicator">

        <TextView
            android:id="@+id/detailOverview"
            style="@style/AppText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/appTextSecondary"
            tools:text="작품 소개가 여기에 표시됩니다." />

        <TextView
            android:id="@+id/detailInfo"
            style="@style/AppText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/appTextSecondary"
            android:visibility="gone"
            tools:text="작가: 작가명\n분류: 판타지 / 액션\n회차: 120개"
            tools:visibility="visible" />

    </LinearLayout>

    <TextView
        android:id="@+id/topEpisodesLabel"
        style="@style/AppText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="회차"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/detailContent" />

    <TextView
        android:id="@+id/topEpisodesSeeAll"
        style="@style/AppText.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="전체보기"
        android:textColor="@color/appAccent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/topEpisodesLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/topEpisodesLabel"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
