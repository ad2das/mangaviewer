<?xml version="1.0" encoding="utf-8" standalone="no"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="64dp"
    android:layout_width="match_parent">

    <TextView
        android:id="@+id/noti_content"
        style="@style/AppText.Body"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/app_space_sm"
        android:layout_marginStart="@dimen/app_space_md"
        android:layout_marginTop="@dimen/app_space_sm"
        android:layout_width="0dp"
        android:singleLine="true"
        android:text="다운로드 준비 중"
        app:layout_constraintEnd_toStartOf="@+id/noti_queue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/noti_progress"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/app_space_md"
        android:layout_marginStart="@dimen/app_space_md"
        android:layout_marginTop="@dimen/app_space_sm"
        android:layout_width="0dp"
        android:max="1000"
        android:progress="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noti_content"
        style="?android:attr/progressBarStyleHorizontal" />

    <TextView
        android:id="@+id/noti_queue"
        style="@style/AppText.Meta"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/app_space_md"
        android:layout_marginTop="@dimen/app_space_sm"
        android:layout_width="wrap_content"
        android:text="0/0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
