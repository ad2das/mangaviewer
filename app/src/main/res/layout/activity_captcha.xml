<?xml version="1.0" encoding="utf-8" standalone="no"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/captchaContainer"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="@color/appSurface"
    tools:context=".activity.CaptchaActivity">

    <WebView
        android:id="@+id/captchaWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/captchaText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </WebView>

    <TextView
        style="@style/AppText.Title"
        android:background="@color/appCard"
        android:id="@+id/captchaText"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:paddingBottom="@dimen/app_space_md"
        android:paddingTop="@dimen/app_space_md"
        android:text="CAPTCHA 인증중.."
        android:textAlignment="center"
        android:textColor="@color/appText"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/captchaActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <LinearLayout
        android:id="@+id/captchaActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/appCard"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/app_space_md"
        android:paddingEnd="@dimen/app_space_md"
        android:paddingBottom="@dimen/app_space_md"
        app:layout_constraintBottom_toTopOf="@+id/progressBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/captchaReload"
            style="@style/AppText.Action"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/app_space_sm"
            android:layout_weight="1"
            android:background="@drawable/app_outline_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="새로고침"
            android:textColor="@color/appText" />

        <TextView
            android:id="@+id/captchaCheckCookie"
            style="@style/AppText.Action"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/app_space_sm"
            android:layout_marginEnd="@dimen/app_space_sm"
            android:layout_weight="1"
            android:background="@drawable/app_accent_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="쿠키 확인"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/captchaPasteCookie"
            style="@style/AppText.Action"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/app_space_sm"
            android:layout_marginEnd="@dimen/app_space_sm"
            android:layout_weight="1"
            android:background="@drawable/app_outline_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="붙여넣기"
            android:textColor="@color/appText" />

        <TextView
            android:id="@+id/captchaClose"
            style="@style/AppText.Action"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/app_space_sm"
            android:layout_weight="1"
            android:background="@drawable/app_outline_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="닫기"
            android:textColor="@color/appText" />
    </LinearLayout>

    <ProgressBar
        android:background="@color/appCard"
        android:id="@+id/progressBar"
        android:indeterminate="true"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        style="?android:attr/progressBarStyleHorizontal" />

    <TextView
        style="@style/AppText.Meta"
        android:background="@drawable/app_outline_button_bg"
        android:id="@+id/infoText"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:padding="@dimen/app_space_md"
        android:visibility="gone"
        android:layout_margin="@dimen/app_space_lg"
        android:clickable="false"
        android:focusable="false"
        android:text="정상적인 웹 페이지가 나올 때까지 자동으로 종료되지 않을 경우, CAPTCHA 문제가 아니므로 다른 방법(URL 변경, 앱 재시작)을 시도해 보세요."
        android:textAlignment="center"
        android:textColor="@color/appTextSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/captchaText" />

</androidx.constraintlayout.widget.ConstraintLayout>
