<?xml version="1.0" encoding="utf-8" standalone="no"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="@color/appSurface"
    tools:context=".activity.AdvSearchActivity">

    <ScrollView
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:clipToPadding="false"
            android:orientation="vertical">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/app_search_box_bg"
                android:hint="검색어"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/appText"
                android:textColorHint="@color/appTextSecondary"
                android:textSize="14sp" />

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingBottom="8dp"
                android:paddingEnd="20dp"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:text="이름"
                android:textColor="@color/appText"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/search_name"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingBottom="8dp"
                android:paddingEnd="20dp"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:text="발행"
                android:textColor="@color/appText"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/search_release"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingBottom="8dp"
                android:paddingEnd="20dp"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:text="장르"
                android:textColor="@color/appText"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/search_tags"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

            </androidx.recyclerview.widget.RecyclerView>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingBottom="8dp"
                android:paddingEnd="20dp"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:text="정렬"
                android:textColor="@color/appText"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:entries="@array/searchSortMethod"
                android:id="@+id/searchSort"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/app_search_box_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:paddingBottom="8dp"
                android:paddingEnd="20dp"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:text="검색 방법"
                android:textColor="@color/appText"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:entries="@array/searchMethods"
                android:id="@+id/searchMethod"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/app_search_box_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <Button
                android:id="@+id/advSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/app_accent_button_bg"
                android:foreground="?android:attr/selectableItemBackground"
                android:minHeight="0dp"
                android:text="검색"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
