<?xml version="1.0" encoding="utf-8" standalone="no"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/appSurface"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    tools:context=".activity.TagSearchActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tagSearchToolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/appSurface"
        android:elevation="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIconTint="@color/appText"
        app:titleTextColor="@color/appText" />

    <TextView
        android:id="@+id/tagSearchNoResult"
        style="@style/AppText.Body"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_width="0dp"
        android:background="@drawable/app_info_panel_bg"
        android:gravity="center"
        android:paddingStart="@dimen/app_space_lg"
        android:paddingTop="@dimen/app_space_lg"
        android:paddingEnd="@dimen/app_space_lg"
        android:paddingBottom="@dimen/app_space_lg"
        android:text="검색 결과가 없습니다"
        android:textColor="@color/appTextSecondary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tagSearchMeta"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tagSearchMeta"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:background="@color/appSurface"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tagSearchToolbar">

        <TextView
            android:id="@+id/tagSearchMetaTitle"
            style="@style/AppText.Meta"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:background="@drawable/app_soft_chip_bg"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="결과 목록"
            android:textColor="@color/appAccent"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tagSearchStatusFilters"
            app:layout_constraintEnd_toStartOf="@+id/tagSearchMetaHint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tagSearchMetaHint"
            style="@style/AppText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="@dimen/app_space_sm"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="결과 준비 중"
            android:textColor="@color/appTextSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/tagSearchStatusFilters"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tagSearchMetaHint"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tagSearchFilterAll"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/app_soft_chip_bg"
                android:gravity="center"
                android:text="전체"
                android:textColor="@color/appAccent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tagSearchFilterOngoing"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/app_soft_chip_bg"
                android:gravity="center"
                android:text="연재"
                android:textColor="@color/appTextSecondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tagSearchFilterCompleted"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/app_soft_chip_bg"
                android:gravity="center"
                android:text="완결"
                android:textColor="@color/appTextSecondary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.omadahealth.github.swipyrefreshlayout.library.SwipyRefreshLayout
        android:id="@+id/tagSearchSwipe"
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tagSearchMeta"
        app:srl_direction="bottom">

        <ml.melun.mangaview.ui.StableScrollbarRecyclerView
            android:id="@+id/tagSearchResult"
            android:background="@color/appSurface"
            android:clipToPadding="false"
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:paddingTop="10dp"
            android:paddingBottom="14dp"
            android:scrollbars="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.omadahealth.github.swipyrefreshlayout.library.SwipyRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
