<?xml version="1.0" encoding="utf-8" standalone="no"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:layout_marginStart="@dimen/app_space_lg"
    android:layout_marginEnd="@dimen/app_space_lg"
    android:background="@color/appCard"
    android:foreground="?android:attr/selectableItemBackground">

    <androidx.cardview.widget.CardView
        android:id="@+id/episodeThumbCard"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginStart="@dimen/app_space_xs"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/episodeThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/app_cover_placeholder"
            android:scaleType="centerCrop" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/episode"
        style="@style/AppText.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/app_space_md"
        android:layout_marginTop="@dimen/app_space_md"
        android:layout_marginEnd="@dimen/app_space_sm"
        android:ellipsize="end"
        android:maxLines="1"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/episodeAction"
        app:layout_constraintStart_toEndOf="@+id/episodeThumbCard"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="#179" />

    <TextView
        android:id="@+id/date"
        style="@style/AppText.Meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/app_space_md"
        android:layout_marginTop="@dimen/app_space_sm"
        android:layout_marginEnd="@dimen/app_space_sm"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/episodeAction"
        app:layout_constraintStart_toEndOf="@+id/episodeThumbCard"
        app:layout_constraintTop_toBottomOf="@+id/episode"
        tools:text="May 1, 2026" />

    <TextView
        android:id="@+id/episodeNew"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:background="@drawable/app_accent_button_bg"
        android:gravity="center"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:text="NEW"
        android:textColor="@android:color/white"
        android:textSize="@dimen/app_text_caption"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/episode"
        app:layout_constraintEnd_toStartOf="@+id/episodeAction"
        app:layout_constraintTop_toTopOf="@+id/episode" />

    <ImageView
        android:id="@+id/episodeAction"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/download" />

    <View
        android:id="@+id/view"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/appDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/episode" />

</androidx.constraintlayout.widget.ConstraintLayout>
