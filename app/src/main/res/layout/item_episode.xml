<?xml version="1.0" encoding="utf-8" standalone="no"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/episodeCard"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/app_episode_row_bg"
    android:clipToOutline="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:minHeight="96dp"
    android:outlineProvider="background">

    <ImageView
        android:id="@+id/episodeThumb"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="14dp"
        android:background="@drawable/app_cover_placeholder"
        android:clipToOutline="true"
        android:contentDescription="@string/episode_thumbnail"
        android:outlineProvider="background"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/episode"
        style="@style/AppText.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/appText"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/episodeAction"
        app:layout_constraintStart_toEndOf="@+id/episodeThumb"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="#179 - 마지막 전투" />

    <TextView
        android:id="@+id/date"
        style="@style/AppText.Meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/episodeAction"
        app:layout_constraintStart_toEndOf="@+id/episodeThumb"
        app:layout_constraintTop_toBottomOf="@+id/episode"
        tools:text="2026.05.09" />

    <TextView
        android:id="@+id/episodeNew"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:background="@drawable/app_accent_button_bg"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/new_badge"
        android:textColor="@color/colorTextOnPrimary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/episode"
        app:layout_constraintEnd_toStartOf="@+id/episodeAction"
        app:layout_constraintTop_toTopOf="@+id/episode" />

    <ImageView
        android:id="@+id/episodeAction"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/app_soft_chip_bg"
        android:clickable="true"
        android:contentDescription="@string/download_episode"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/download" />

</androidx.constraintlayout.widget.ConstraintLayout>
