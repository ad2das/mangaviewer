<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="252dp"
    android:background="@color/appSurface"
    android:paddingStart="@dimen/app_space_md"
    android:paddingTop="@dimen/app_space_sm"
    android:paddingEnd="@dimen/app_space_md"
    android:paddingBottom="@dimen/app_space_sm">

    <androidx.cardview.widget.CardView
        android:id="@+id/hero_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="@color/appCard"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@+id/hero_dots"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/hero_thumb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/app_hero_placeholder"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/app_hero_scrim"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/hero_badge"
                style="@style/AppText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="@dimen/app_space_lg"
                android:layout_marginTop="@dimen/app_space_lg"
                android:background="@drawable/app_soft_chip_bg"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="추천"
                android:textColor="@color/appInk"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_space_lg"
                android:layout_marginTop="@dimen/app_space_md"
                android:layout_marginEnd="@dimen/app_space_lg"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hero_badge"
                tools:text="Solo Leveling" />

            <TextView
                android:id="@+id/hero_meta"
                style="@style/AppText.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_space_lg"
                android:layout_marginTop="@dimen/app_space_sm"
                android:layout_marginEnd="@dimen/app_space_lg"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#F4F0FF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hero_title"
                tools:text="Latest chapter is ready." />

            <TextView
                android:id="@+id/hero_read_button"
                style="@style/AppText.Action"
                android:layout_width="128dp"
                android:layout_height="42dp"
                android:layout_marginStart="@dimen/app_space_lg"
                android:layout_marginBottom="@dimen/app_space_lg"
                android:background="@drawable/app_accent_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="보러가기"
                android:textColor="@android:color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/hero_dots"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:gravity="center"
        android:textColor="@color/appAccent"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="●  ○  ○  ○" />

</androidx.constraintlayout.widget.ConstraintLayout>
