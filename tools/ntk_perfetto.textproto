buffers: {
  size_kb: 65536
  fill_policy: RING_BUFFER
}
buffers: {
  size_kb: 16384
  fill_policy: RING_BUFFER
}
data_sources: {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_wakeup_new"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      ftrace_events: "binder/binder_transaction"
      ftrace_events: "binder/binder_transaction_received"
      atrace_categories: "am"
      atrace_categories: "binder_driver"
      atrace_categories: "dalvik"
      atrace_categories: "freq"
      atrace_categories: "gfx"
      atrace_categories: "memory"
      atrace_categories: "res"
      atrace_categories: "sched"
      atrace_categories: "view"
      atrace_categories: "wm"
      atrace_apps: "ml.melun.mangaview"
    }
  }
}
data_sources: {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
      proc_stats_poll_ms: 250
    }
  }
}
data_sources: {
  config {
    name: "android.log"
    target_buffer: 1
    android_log_config {
      log_ids: LID_DEFAULT
      log_ids: LID_EVENTS
      log_ids: LID_SYSTEM
    }
  }
}
data_sources: {
  config {
    name: "android.packages_list"
    target_buffer: 1
  }
}
data_sources: {
  config {
    # Optional producer on older releases. Perfetto simply leaves this source
    # inactive when SurfaceFlinger does not advertise it; the trace still runs.
    name: "android.surfaceflinger.frametimeline"
    target_buffer: 0
  }
}
data_sources: {
  config {
    # Optional GPU service producer; absence is non-fatal for the session.
    name: "android.gpu.memory"
    target_buffer: 1
  }
}
data_sources: {
  config {
    name: "linux.sys_stats"
    target_buffer: 1
    sys_stats_config {
      meminfo_period_ms: 250
      meminfo_counters: MEMINFO_MEM_TOTAL
      meminfo_counters: MEMINFO_MEM_FREE
      meminfo_counters: MEMINFO_MEM_AVAILABLE
      meminfo_counters: MEMINFO_BUFFERS
      meminfo_counters: MEMINFO_CACHED
      meminfo_counters: MEMINFO_SWAP_TOTAL
      meminfo_counters: MEMINFO_SWAP_FREE
      stat_period_ms: 250
      stat_counters: STAT_CPU_TIMES
      stat_counters: STAT_FORK_COUNT
      cpufreq_period_ms: 250
    }
  }
}
duration_ms: 600000
flush_period_ms: 1000
write_into_file: true
file_write_period_ms: 2500
